# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose in browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Browser Rendering (server only)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# App URL (used for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# External APIs (server only)
GOOGLE_PLACES_API_KEY=
SERP_API_KEY=
ANTHROPIC_API_KEY=

# Resend — resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Inbox that contact form messages are delivered to
SUPPORT_EMAIL=support@yourdomain.com

# Inngest
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

SITE_PASSWORD=yourpassword
# Server log verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info
